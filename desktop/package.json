{
  "name": "vorax-helper-overlay",
  "productName": "Vorax Helper",
  "version": "1.0.1",
  "description": "Vorax Helper as a Windows app, with its advice in a small card over the game.",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy-web": "node scripts/copy-web.js",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --win --publish never"
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "local.vorax-helper.overlay",
    "productName": "Vorax Helper",
    "files": [
      "main.js",
      "preload.js",
      "card.js",
      "highlight.js",
      "overlay/**",
      "mark/**",
      "ocr/**",
      "web/**",
      "build/icon.png",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "ocr/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Vorax-Helper-Setup.${ext}"
    }
  }
}
